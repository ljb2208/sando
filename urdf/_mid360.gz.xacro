<?xml version="1.0"?>

<!--
Gazebo Sim (gz) approximation of the Livox Mid-360 (ros2_livox_simulation's mid360.xacro, which
is Gazebo Classic only). The Mid-360's non-repetitive scan pattern is replaced with a regular
gpu_lidar grid over the same field of view (360 deg x -7.22..55.22 deg) and range (20 m), at
about the same point count per frame (~20k points at 10 Hz).
Points are published on <topic>/points, i.e. ${namespace}/${topic}/points, and bridged to ROS as
${namespace}/${topic}_PointCloud2 (see onboard_sando.launch.py), the Classic plugin's topic.
-->

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="M_PI" value="3.1415926"/>

  <xacro:macro name="mid360" params="name:=''
                                     namespace:='quadrotor'
                                     parent:='base_link'
                                     topic:='mid360'
                                     *origin">

    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="6e-5" ixy="0.0" ixz="0.0" iyy="1.1e-4" iyz="0.0" izz="1.1e-4"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <gazebo reference="${name}">
      <sensor type="gpu_lidar" name="${name}">
        <!-- Same frame as the Classic plugin (namespace/sensor name) -->
        <gz_frame_id>${namespace}/${name}</gz_frame_id>
        <topic>${namespace}/${topic}</topic>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>0</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>${-M_PI}</min_angle>
              <max_angle>${M_PI}</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>${-7.22/180*M_PI}</min_angle>
              <max_angle>${55.22/180*M_PI}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>20.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
